<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>WasmGc.Ir</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Pure WExpr query and dump utilities; Fable.AST is referenced only to satisfy the type checker (see below). -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/WasmGc.Core.fsproj" />
    <!-- WasmGc.Core's assembly mentions Fable.AST types (ICompilerCore) in its signatures, so every consumer needs the
         reference to type-check (FS0074). PrivateAssets keeps it from flowing on to this project's own consumers. -->
    <ProjectReference Include="../../vendor/Fable/src/Fable.AST/Fable.AST.fsproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- WExprQuery must precede IrDump (dump uses query). -->
    <Compile Include="WExprQuery.fs" />
    <Compile Include="IrDump.fs" />
  </ItemGroup>
</Project>
