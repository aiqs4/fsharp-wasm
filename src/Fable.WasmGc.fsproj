<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Fable.WasmGc</AssemblyName>
    <PackageId>Fable.WasmGc</PackageId>
    <!--
      Targets net10.0 to match Fable.Compiler NuGet (net10.0).
      Source files are physically in this directory — no fork dependency.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>

    <IsPackable>true</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <OtherFlags>$(OtherFlags) --nowarn:3536 --nowarn:3261</OtherFlags>
    <DebugType>embedded</DebugType>
    <RootNamespace>WasmGc</RootNamespace>
    <Authors>fsharp-wasm contributors</Authors>
    <Description>WasmGC backend for the Fable F# compiler.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fsharp-wasm/fsharp-wasm</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/fsharp-wasm/fsharp-wasm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
      <!-- Use the exact assembly name of your Expecto test project -->
    <InternalsVisibleTo Include="TestNative" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Official Fable.Compiler NuGet — provides Fable.AST, Fable.Transforms, FSharp.Compiler.Service.
      PrivateAssets="all" prevents these NuGet DLLs from propagating to consumers (e.g. the fork's Fable.Cli).
      The fork provides its own Fable.Transforms.dll / Fable.Compiler.dll which have the same assembly
      identity (Fable-Transforms 1.0.0.0) and compatible interfaces — so Fable.WasmGc.dll
      resolves correctly at runtime against the fork's assemblies.
    -->
    <!-- <PackageReference Include="Fable.Compiler" Version="5.0.0-rc.11" PrivateAssets="all" /> -->

    <ProjectReference Include="../vendor/Fable/src/Fable.Compiler/Fable.Compiler.fsproj" />
    <ProjectReference Include="../vendor/Fable/src/Fable.AST/Fable.AST.fsproj" PrivateAssets="all" />
    <ProjectReference Include="../vendor/Fable/src/Fable.Transforms/Fable.Transforms.fsproj" />

    <!-- <Reference Include="../vendor/Fable/src/Fable.Compiler/bin/Debug/net10.0/Fable.Compiler.dll" PrivateAssets="all" /> -->

    <Reference Include="../vendor/Fable/lib/fcs/FSharp.Compiler.Service.dll" />
    <Reference Include="../vendor/Fable/lib/fcs/FSharp.DependencyManager.Nuget.dll" />
    <Reference Include="../vendor/Fable/lib/fcs/FSharp.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Source order (strict dependency order):
        1. WasmGC AST types (WasmGc.Core.AST) — no deps on Fable.Transforms
        2. Ctx / type mapping (depends on AST)
        3. CE Builder (depends on Types)
        4. Loop helpers, free-var analysis
        5. Free-variable analysis
        6. Runtime helpers (string concat, collectLocals, fixClosure)
        7. BCL inline replacements (Option, Result, List, Array, Math, String)
        8. Main Fable→WasmIR translator
        9. Optimizer
        10. WAT text emitter
        11. Low-level struct emitter
        12. Binary encoder
    -->
    <!-- Core -->
    <Compile Include="Core/AST.fs" />
    <Compile Include="Core/Diagnostics.fs" />
    <Compile Include="Core/Types.fs" />

    <!-- Utilities (no Ctx dependency) -->
    <Compile Include="Util/WExprQuery.fs" />
    <Compile Include="Util/FableQuery.fs" />
    <Compile Include="Util/FableAstDump.fs" />
    <Compile Include="Util/IrDump.fs" />

    <!-- Builder -->
    <Compile Include="Builder/Builder.fs" />
    <Compile Include="Builder/Locals.fs" />
    <Compile Include="Builder/Equality.fs" />

    <!-- Runtime -->
    <Compile Include="Runtime/FreeVars.fs" />
    <Compile Include="Runtime/ListShape.fs" />
    <Compile Include="Runtime/LoopPrimitives.fs" />
    <Compile Include="Runtime/ArrayOps.fs" />
    <Compile Include="Runtime/ListOps.fs" />
    <Compile Include="Runtime/VTable.fs" />
    <Compile Include="Runtime/LoopHelpers.fs" />
    <Compile Include="Runtime/QuotationWalker.fs" />
    <Compile Include="Runtime/Runtime.fs" />

    <!-- Pipeline -->
    <Compile Include="Pipeline/TypeResolver.fs" />
    <Compile Include="Pipeline/ScopeAnalyzer.fs" />
    <Compile Include="Pipeline/Normalizer.fs" />
    <Compile Include="Pipeline/Lower.fs" />
    <Compile Include="Pipeline/Scope.fs" />
    <Compile Include="Pipeline/Validator.fs" />
    <Compile Include="Pipeline/Dumps.fs" />

    <!-- Transforms -->
    <Compile Include="Transforms/MathMap.fs" />
    <Compile Include="Transforms/OptionResult.fs" />
    <Compile Include="Transforms/ListCombinators.fs" />
    <Compile Include="Transforms/ListOps.fs" />
    <Compile Include="Transforms/ArrayReplacements.fs" />
    <Compile Include="Transforms/FSharpCoreReplacements.fs" />
    <Compile Include="Transforms/Helpers.fs" />

    <!-- New modularized Fable2Wasm components -->
    <Compile Include="Transforms/Fable2Wasm/TransformConstruct.fs" />
    <Compile Include="Transforms/ClosureBuilder.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformClosure.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformDispatch.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformDecisionTree.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformTest.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformOperation.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformMemberDecl.fs" />
    <Compile Include="Transforms/Fable2Wasm/TransformExpr.fs" />
    <Compile Include="Transforms/Fable2Wasm/Fable2Wasm.fs" />

    <!-- Emit -->
    <Compile Include="Emit/Optimize.fs" />
    <Compile Include="Emit/Emit.fs" />
    <Compile Include="Emit/Encoder.fs" />
    <Compile Include="Emit/Wat.fs" />

    <Compile Include="Pipeline/Phases.fs" />

    <!-- Top-level Pipeline -->
    <Compile Include="Pipeline.fs" />
  </ItemGroup>
</Project>
