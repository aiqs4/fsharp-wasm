<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>

    <!-- <TargetsDirectory>$(FSharpWasmGC)/artifacts/bin/examples/component-embed/MathCore/$(Configuration)/$(TargetFramework)</TargetsDirectory> -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pure math library compiled to WasmGC.
      No imports — exports only primitive-type functions.
      This is one half of the component-embedding example.
    -->
    <Compile Include="MathCore.fs" />
  </ItemGroup>

</Project>
