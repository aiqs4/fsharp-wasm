<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WasmGc.Bcl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only needs Core (WExpr/WType) and Builder DSL — no Fable.AST dependency -->
    <ProjectReference Include="../Core/WasmGc.Core.fsproj" />    
  </ItemGroup>
  <ItemGroup>
    <Compile Include="StringHelpers.fs" />
    <Compile Include="CharHelpers.fs" />
    <Compile Include="MathHelpers.fs" />
    <Compile Include="StringBuilderHelpers.fs" />
    <Compile Include="BclRegistry.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- TODO: we should get rid of this. We don't need compiler here -->
    <!-- <Reference Include="../../vendor/Fable/lib/fcs/FSharp.Compiler.Service.dll" /> -->
    <Reference Include="../../vendor/Fable/lib/fcs/FSharp.Core.dll" />
  </ItemGroup>
</Project>
