<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference side of the differential test.  A compiled project (not a script): `dotnet fsi` carries its own
       FSharp.Core, which cannot load a test assembly built against a newer one.  Directory.Build.targets pins the
       same FSharp.Core for this project and for the assembly under test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
