<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference> -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WasmGc.Builder</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only needs Core (WExpr/WType) and Builder DSL — no Fable.AST dependency -->
    <ProjectReference Include="../Core/WasmGc.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Builder.fs" />
    <Compile Include="Locals.fs" />
    <Compile Include="Equality.fs" />
    <Compile Include="Operators.fs" />
  </ItemGroup>
</Project>