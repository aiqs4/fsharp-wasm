<Project>
  <!-- Global defaults for first-party projects (applies repo-wide) -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <FableCoreOnly>true</FableCoreOnly>
    <DefineConstants>$(DefineConstants);FABLE_CORE_ONLY</DefineConstants>

    <FableCoreNet10>true</FableCoreNet10>
    <DefineConstants>$(DefineConstants);FABLE_CORE_NET10</DefineConstants>

    <FableCoreVersion>net11.0</FableCoreVersion>

    <FSharpNetCoreProductTargetFramework>net11.0</FSharpNetCoreProductTargetFramework>
  </PropertyGroup>

  <!--
    Patched F# compiler support.

    When FSHARP_COMPILER env var is set (done by .envrc when the binary exists),
    override FscToolPath to use the patched fsc.dll from vendor/fsharp.

    To build the patched compiler:
      cd vendor/fsharp
      DOTNET_INSTALL_DIR=dotnet-root ./build.sh -configuration Release

    FSHARP_COMPILER is set to:
      vendor/fsharp/artifacts/bin/fsc/Release/net11.0/fsc.dll
  -->
  <PropertyGroup Condition="'$(FSHARP_COMPILER)' != ''">
    <!-- <FscToolPath>$([System.IO.Path]::GetDirectoryName('$(FSHARP_COMPILER)'))</FscToolPath> -->
    <!-- <FscToolExe>fsc.dll</FscToolExe> -->
    <!-- Override the dotnet fsc compiler path with the patched version. -->
    <!-- The standard SDK uses DotnetFscCompilerPath for managed (dotnet) fsc invocations. -->
    <DotnetFscCompilerPath>$(FSHARP_COMPILER)</DotnetFscCompilerPath>
    <FSharpWasmGC Condition="'$(FSharpWasmGC)' == ''">$(MSBuildThisFileDirectory)</FSharpWasmGC>
  </PropertyGroup>
</Project>
