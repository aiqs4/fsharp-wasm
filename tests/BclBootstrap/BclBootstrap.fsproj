<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fable.Core stubs (Import attribute, nativeOnly) -->
    <Compile Include="../../fable-library-wasmgc/Core/Interop.fs" />
    <!-- BCL bootstrap: Exception hierarchy + Math -->
    <Compile Include="../../fsharp-wasm-core/FSharp.Wasm.Core/Exception.fs" />
    <Compile Include="../../fsharp-wasm-core/FSharp.Wasm.Core/Math.fs" />
    <!-- Test driver -->
    <Compile Include="BclBootstrapTests.fs" />
  </ItemGroup>

</Project>
