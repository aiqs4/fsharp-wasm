<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>WasmGc.Patterns</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!--
      WasmGC algorithm library — pure WExpr builders with NO Fable.AST dependency.
      These are the reusable building blocks for:
        - BCL helper builders (WasmGc.Bcl)
        - Fable→WExpr dispatch glue (Transforms/)
        - External BCL/library projects
      Any code that generates WExpr but doesn't parse Fable.Expr goes here.
    -->
  </PropertyGroup>
  <ItemGroup>
    <!-- <PackageReference Include="FSharp.Core"             Version="10.1.203" /> -->

    <ProjectReference Include="../Core/WasmGc.Core.fsproj" />
    <ProjectReference Include="../Builder/WasmGc.Builder.fsproj" />
    <ProjectReference Include="../Ir/WasmGc.Ir.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Primitive types / utilities used by all pattern modules. -->
    <Compile Include="ListShape.fs" />
    <!-- Control flow building blocks (makeWhileLoop is in Builder; these are higher-level). -->
    <Compile Include="LoopPrimitives.fs" />
    <!-- Pure WExpr algorithm implementations. -->
    <Compile Include="ListPatterns.fs" />
    <Compile Include="ArrayPatterns.fs" />
    <Compile Include="ClosurePatterns.fs" />
    <Compile Include="VTable.fs" />
  </ItemGroup>
</Project>
